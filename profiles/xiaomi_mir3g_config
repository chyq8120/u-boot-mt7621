#
# 板级核心配置 (小米 R3G 硬件定义)
#
CONFIG_BOARD_XIAOMI_MIR3G=y
CONFIG_SOC_MT7621=y

# CPU 与 内存 (DDR3, 256MB, 1200Mhz)
CONFIG_MT7621_CPU_1000MHZ=y
CONFIG_MT7621_DDR3=y
CONFIG_MT7621_DDR_1200MHZ=y
CONFIG_MT7621_DDR_SIZE_256MB=y

# 闪存类型 (必须是 NAND，绝对不能是 SPI_NOR)
CONFIG_FLASH_NAND=y
CONFIG_MTK_NAND=y

# 串口与控制台设置 (用于 TTL 救砖)
CONFIG_SERIAL_SUPPORT=y
CONFIG_RALINK_CMDLINE=y

# 功能增强组件 (根据你之前在网页上的勾选需求)
CONFIG_HTTPD_SUPPORT=y
CONFIG_TFTP_SUPPORT=y
CONFIG_DHCP_SUPPORT=y

# 小米 R3G 物理引脚定义 (复位键与 LED 灯，对应主板物理走线)
CONFIG_GPIO_BTN_RESET=18
CONFIG_GPIO_BTN_WPS=7
CONFIG_GPIO_LED_ALL=1
CONFIG_GPIO_LED_INIT1=1
CONFIG_GPIO_LED_INIT2=-1
CONFIG_GPIO_LED_ALERT1=13
